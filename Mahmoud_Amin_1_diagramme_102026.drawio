<mxfile host="app.diagrams.net" type="device">
  <diagram id="BottleNeck_Kestra_Pipeline" name="Architecture Pipeline BottleNeck">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- TITRE -->
        <mxCell id="title" value="Architecture d&#39;Automatisation &amp; Tests (Logigramme) - Pipeline Kestra / BottleNeck" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="760" height="40" as="geometry" />
        </mxCell>

        <!-- TRIGGER -->
        <mxCell id="trigger" value="⏰ TRIGGER (Planification Kestra)&#xa;Tous les 15 du mois à 09h00 (Cron : 0 9 15 * *)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="80" width="380" height="50" as="geometry" />
        </mxCell>

        <!-- SOURCES & INGESTION -->
        <mxCell id="src_erp" value="📄 Fichier_erp.xlsx&#xa;(825 lignes brutes)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="180" y="160" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="src_liaison" value="📄 fichier_liaison.xlsx&#xa;(825 lignes brutes)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="520" y="160" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="src_web" value="📄 Fichier_web.xlsx&#xa;(1513 lignes brutes)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="860" y="160" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- TACHE 1 : INGESTION & NETTOYAGE VALEURS MANQUANTES -->
        <mxCell id="t1_clean" value="🛠️ Tâche 1 (Python / DuckDB SQL) : Vérification des sources, Ingestion &amp; Nettoyage&#xa;- Contrôle de présence/intégrité des 3 fichiers .xlsx &amp; connexion DuckDB (avec Retry)&#xa;- Chargement dans DuckDB (typage id_web / sku en VARCHAR) &amp; filtrage WHERE sku IS NOT NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="260" width="600" height="65" as="geometry" />
        </mxCell>

        <!-- TEST 1 : VALEURS MANQUANTES -->
        <mxCell id="test1" value="✅ TEST 1 (DuckDB SQL) : Contrôle d&#39;absence de valeurs manquantes&#xa;- Vérification 0 NULL sur product_id (erp, liaison) et sku (web_clean)&#xa;- Vérification volumétrie web_clean = 1 428 lignes exactes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="355" width="520" height="60" as="geometry" />
        </mxCell>

        <!-- TACHE 2 : DEDOUBLONNAGE -->
        <mxCell id="t2_dedup" value="🛠️ Tâche 2 (DuckDB SQL) : Dédoublonnage des 3 tables&#xa;- erp_dedup : unicité sur product_id&#xa;- liaison_dedup : unicité sur product_id&#xa;- web_dedup : filtrage post_type = &#39;product&#39; &amp; unicité sur sku" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="445" width="580" height="75" as="geometry" />
        </mxCell>

        <!-- TEST 2 : UNICITE & VOLUMETRIE DEDOUBLONNAGE -->
        <mxCell id="test2" value="✅ TEST 2 (DuckDB SQL) : Contrôle d&#39;absence de doublons &amp; Unicité des clés&#xa;- erp_dedup = 825 lignes uniques | liaison_dedup = 825 lignes uniques&#xa;- web_dedup = 714 lignes uniques (0 doublon sur les clés primaires)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="550" width="520" height="60" as="geometry" />
        </mxCell>

        <!-- TACHE 3 : FUSION / JOINTURE -->
        <mxCell id="t3_join" value="🛠️ Tâche 3 (DuckDB SQL) : Réconciliation &amp; Fusion (INNER JOIN)&#xa;- Jointure erp_dedup + liaison_dedup (sur product_id) + web_dedup (sur id_web = sku)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="640" width="580" height="60" as="geometry" />
        </mxCell>

        <!-- TEST 3 : COHERENCE JOINTURE -->
        <mxCell id="test3" value="✅ TEST 3 (DuckDB SQL) : Contrôle de cohérence de la jointure&#xa;- Table fusionnée = 714 lignes exactes | 0 NULL sur price et total_sales | price &gt; 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="730" width="520" height="55" as="geometry" />
        </mxCell>

        <!-- BRANCHE GAUCHE : CALCUL CA (SQL) -->
        <mxCell id="t4_ca" value="🛠️ Tâche 4A (DuckDB SQL) : Calcul du Chiffre d&#39;Affaires&#xa;- CA par produit = ROUND(price * total_sales, 2)&#xa;- Agrégation du CA Total global" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="830" width="400" height="65" as="geometry" />
        </mxCell>

        <mxCell id="test4_ca" value="✅ TEST 4A (DuckDB SQL) : Contrôle de cohérence du CA&#xa;- Vérification CA Total == 70 568.60 € &amp; aucun CA négatif" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="925" width="400" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ext_xlsx" value="📊 Extraction Rapport Excel (.xlsx)&#xa;- Onglet 1 : CA par produit (714 lignes)&#xa;- Onglet 2 : CA Total (70 568.60 €)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="1020" width="360" height="70" as="geometry" />
        </mxCell>

        <!-- BRANCHE DROITE : CALCUL Z-SCORE (PYTHON) -->
        <mxCell id="t4_zscore" value="🐍 Tâche 4B (Python) : Calcul du Z-Score sur les prix&#xa;- z_score = (price - moyenne(price)) / ecart_type(price)&#xa;- Segmentation : Millésime si z_score &gt; 2, sinon Ordinaire" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="830" width="420" height="65" as="geometry" />
        </mxCell>

        <mxCell id="test4_zscore" value="✅ TEST 4B (Python) : Contrôle du Z-Score &amp; Volumétrie&#xa;- Vins Premium (z &gt; 2) == 30 | Vins Ordinaires (z &lt;= 2) == 684&#xa;- Total (30 + 684) == 714 lignes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="925" width="420" height="60" as="geometry" />
        </mxCell>

        <!-- SOUS-BRANCHES PARALLELES CSV -->
        <mxCell id="ext_premium" value="🍾 Branche 1 : Export CSV&#xa;vins_premium.csv&#xa;(30 vins millésimes - Pour Laure)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="1025" width="210" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ext_ordinaire" value="🍷 Branche 2 : Export CSV&#xa;vins_ordinaires.csv&#xa;(684 vins ordinaires - Pour Maria)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="1025" width="210" height="70" as="geometry" />
        </mxCell>

        <!-- GESTION DES ERREURS / RESILIENCE -->
        <mxCell id="errors" value="🚨 GESTION DES DYSFONCTIONNEMENTS &amp; RÉSILIENCE (Bloc &#39;errors&#39; &amp; &#39;retry&#39; Kestra)&#xa;- Si Fichier source inaccessible/corrompu ou DuckDB indisponible : Retry automatique (3 tentatives) puis arrêt sécurisé&#xa;- Si un TEST est KO : Arrêt immédiat du pipeline (Fail-Fast) pour bloquer toute extraction erronée&#xa;- Envoi automatique d&#39;une alerte / notification d&#39;erreur à l&#39;équipe Data avec le log précis de la tâche ou du test en échec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
